{
  "name": "julekalender",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test:rules": "firebase emulators:exec --only firestore,storage --project julekal-rules-test \"vitest run\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^13.3.0",
    "isbot": "^5.2.3",
    "react": "^19.3.1",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router": "^8.5.1",
    "react-snowfall": "^2.4.0",
    "react-tooltip": "^6.0.12",
    "react-use": "^17.6.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@react-router/dev": "^8.5.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-tools": "^15.36.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,md}": [
      "oxfmt"
    ],
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix"
    ]
  }
}
