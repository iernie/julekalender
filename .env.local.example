# Local development against the Firebase emulator suite.
#
#   cp .env.local.example .env.local
#
# These values are deliberately fake. The `demo-` project id prefix puts the
# emulators in offline demo mode, so no real Firebase project or login is
# needed and nothing can reach production.
#
# Run in two terminals:
#   1. npm run emulators    (needs Java on PATH)
#   2. npm run seed         (once, to load the default avatars)
#   3. npm run dev
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-julekal.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-julekal
VITE_FIREBASE_STORAGE_BUCKET=demo-julekal.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# To run against the real project instead, set VITE_USE_FIREBASE_EMULATORS=false
# and fill these in from the Firebase console (Project settings -> Your apps).
# Note the production rules and callables must be deployed first.
