rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return signedIn() && request.auth.uid == data.owner;
    }

    function calendarExists(id) {
      return exists(/databases/$(database)/documents/calendars/$(id));
    }

    function calendarData(id) {
      return get(/databases/$(database)/documents/calendars/$(id)).data;
    }

    // Readable if the calendar is public, or the caller owns it.
    function canReadCalendar(id) {
      return calendarExists(id)
        && (calendarData(id).public == true
            || request.auth.uid == calendarData(id).owner);
    }

    function validCalendarId(id) {
      return id.matches('^[a-z0-9æøå_-]{2,40}$');
    }

    match /calendars/{calendarId} {
      // `resource` is null for a document that does not exist. Reading a
      // missing calendar must succeed so the app can check name availability.
      allow get: if resource == null
        || resource.data.public == true
        || isOwner(resource.data);

      // Rules are not filters: for a query, every field the rule reads must be
      // constrained by the query itself. Listing is only ever done as
      // `where("owner", "==", uid)`, so this rule reads nothing else.
      allow list: if isOwner(resource.data);

      allow create: if signedIn()
        && validCalendarId(calendarId)
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name.lower() == calendarId
        && request.resource.data.public is bool
        && request.resource.data.keys().hasOnly(
             ['id', 'name', 'createdAt', 'deleteBy', 'owner', 'public', 'settings']);

      allow update: if isOwner(resource.data)
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.name == resource.data.name;

      allow delete: if isOwner(resource.data);
    }

    match /users/{userId} {
      allow get: if resource == null
        || canReadCalendar(resource.data.calendarId);

      // Listing is only ever done as `where("calendarId", "==", id)`, so this
      // rule reads no other field of the user document.
      allow list: if canReadCalendar(resource.data.calendarId);

      allow create: if isOwner(request.resource.data)
        && calendarExists(request.resource.data.calendarId)
        && request.resource.data.owner == calendarData(request.resource.data.calendarId).owner
        && request.resource.data.won.size() == 0
        && request.resource.data.keys().hasOnly(
             ['id', 'name', 'image', 'calendar', 'calendarId', 'owner', 'createdAt', 'deleteBy', 'won']);

      // Clients may rename and re-avatar, but never touch `won`.
      // Winners are written exclusively by the drawWinner callable.
      allow update: if isOwner(resource.data)
        && request.resource.data.won == resource.data.won
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.calendarId == resource.data.calendarId;

      allow delete: if isOwner(resource.data);
    }
  }
}
