rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return signedIn() && request.auth.uid == data.owner;
    }

    function calendarExists(id) {
      return exists(/databases/$(database)/documents/calendars/$(id));
    }

    function calendarData(id) {
      return get(/databases/$(database)/documents/calendars/$(id)).data;
    }

    // Readable if the calendar is public, or the caller owns it.
    function canReadCalendar(id) {
      return calendarExists(id)
        && (calendarData(id).public == true
            || request.auth.uid == calendarData(id).owner);
    }

    // `avatars/` is the Storage prefix holding the seeded default avatars, and
    // storage.rules grants the owner of calendar `<id>` write access to
    // `<id>/**`. A calendar called `avatars` would therefore hand its owner
    // write access to everyone's default avatars, so the name is reserved.
    function validCalendarId(id) {
      return id.matches('^[a-z0-9æøå_-]{2,40}$') && id != 'avatars';
    }

    // Both collections expire through a TTL policy on `deleteBy`. Firestore
    // ignores the policy for any document whose `deleteBy` is not a timestamp,
    // so a document without one would live forever.
    function expires(data) {
      return data.deleteBy is timestamp && data.createdAt is timestamp;
    }

    // True when an update leaves `field` alone. Reads through `get(key, null)`
    // so a field absent from a document written before these rules does not
    // fail evaluation and lock its owner out.
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // As `unchanged`, but a document that has no value yet may acquire one.
    // Documents predating `expires()` carry no `deleteBy`, and a pin alone
    // would make that permanent — the TTL policy would skip them forever.
    function unchangedOrRepaired(field) {
      return unchanged(field)
        || (resource.data.get(field, null) == null && request.resource.data[field] is timestamp);
    }

    match /calendars/{calendarId} {
      function calendarKeys() {
        return ['id', 'name', 'createdAt', 'deleteBy', 'owner', 'public', 'settings'];
      }

      // `resource` is null for a document that does not exist. Reading a
      // missing calendar must succeed so the app can check name availability.
      allow get: if resource == null
        || resource.data.public == true
        || isOwner(resource.data);

      // Rules are not filters: for a query, every field the rule reads must be
      // constrained by the query itself. Listing is only ever done as
      // `where("owner", "==", uid)`, so this rule reads nothing else.
      allow list: if isOwner(resource.data);

      allow create: if signedIn()
        && validCalendarId(calendarId)
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name.lower() == calendarId
        && request.resource.data.public is bool
        && expires(request.resource.data)
        && request.resource.data.keys().hasOnly(calendarKeys());

      // Only `public` and `settings` are the owner's to change. Pinning the
      // rest keeps `deleteBy` out of reach, so expiry cannot be pushed back.
      // `get(key, null)` rather than a direct read: a field missing from a
      // document predating these rules would otherwise fail evaluation and
      // lock the owner out of their own calendar.
      allow update: if isOwner(resource.data)
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.name == resource.data.name
        && unchanged('id')
        && unchangedOrRepaired('createdAt')
        && unchangedOrRepaired('deleteBy')
        && request.resource.data.get('public', true) is bool
        && request.resource.data.keys().hasOnly(calendarKeys());

      allow delete: if isOwner(resource.data);

      // Users live under their calendar, so the calendar is part of the path
      // rather than a field that could disagree with it. Every rule here reads
      // the parent calendar and nothing from the user document's own
      // ownership, which also means a plain listing of the subcollection
      // satisfies the `list` rule without any `where` clause.
      match /users/{userId} {
        function userKeys() {
          return ['id', 'name', 'image', 'createdAt', 'deleteBy', 'won'];
        }

        function ownsParent() {
          return calendarExists(calendarId) && isOwner(calendarData(calendarId));
        }

        allow read: if canReadCalendar(calendarId);

        allow create: if ownsParent()
          && request.resource.data.id == userId
          && request.resource.data.won.size() == 0
          && expires(request.resource.data)
          && request.resource.data.keys().hasOnly(userKeys());

        // Clients may rename and re-avatar, but never touch `won`.
        // Winners are written exclusively by the drawWinner callable.
        allow update: if ownsParent()
          && unchanged('won')
          && unchanged('id')
          && unchanged('createdAt')
          && unchanged('deleteBy')
          && request.resource.data.keys().hasOnly(userKeys());

        allow delete: if ownsParent();
      }
    }
  }
}
